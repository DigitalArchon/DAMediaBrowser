[Desktop Entry]
# Template. Exec must be an absolute path unless mediabrowser is on the
# session PATH: GIO refuses to load a desktop entry whose Exec program it
# cannot find, and the desktop portal then reports "App info not found".
# See the README for the install command that substitutes it.
Type=Application
Name=DA Media Browser
GenericName=Chapter Browser and Player
Comment=Browse, name and play the chapters of videos and Blu-ray discs
Exec=mediabrowser
Terminal=false
Categories=AudioVideo;Video;Player;
Keywords=video;chapters;bluray;concert;tracklist;musicbrainz;mpv;
StartupWMClass=DA Media Browser
